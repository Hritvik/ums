{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ums.invalid/contracts/v1/profile-state-event.json",
  "type": "object",
  "properties": {
    "eventId": {
      "$ref": "common.json#/$defs/uuid"
    },
    "schemaVersion": {
      "const": "1"
    },
    "producer": {
      "const": "ums"
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}(?![\\s\\S])"
    },
    "occurredAt": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}(?![\\s\\S])"
    },
    "causationId": {
      "$ref": "common.json#/$defs/uuid"
    },
    "type": {
      "const": "ums.profile.state-changed.v1"
    },
    "state": {
      "$ref": "binding-state.json"
    },
    "reason": {
      "enum": [
        "PROVISIONED",
        "FIELDS_CHANGED",
        "POLICY_REEVALUATED",
        "CLOSED",
        "REACTIVATED",
        "DELETION_REQUESTED",
        "DELETION_CANCELLED",
        "ERASED",
        "CONTENT_REVOKED"
      ]
    }
  },
  "required": [
    "eventId",
    "schemaVersion",
    "producer",
    "environment",
    "occurredAt",
    "correlationId",
    "causationId",
    "type",
    "state",
    "reason"
  ],
  "additionalProperties": false
}
