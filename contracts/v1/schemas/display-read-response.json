{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ums.invalid/contracts/v1/display-read-response.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "results"
  ],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profileReference",
              "status",
              "display"
            ],
            "properties": {
              "profileReference": {
                "$ref": "common.json#/$defs/uuid"
              },
              "status": {
                "const": "AVAILABLE"
              },
              "display": {
                "$ref": "profile-display.json"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profileReference",
              "status"
            ],
            "properties": {
              "profileReference": {
                "$ref": "common.json#/$defs/uuid"
              },
              "status": {
                "const": "UNAVAILABLE"
              }
            }
          }
        ]
      }
    }
  }
}
