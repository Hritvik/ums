{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ums.invalid/contracts/v1/association-report.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "producer",
    "environment",
    "occurredAt",
    "correlationId",
    "causationId",
    "aggregate",
    "destination",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "pattern": "^evt_[A-Za-z0-9_-]{16,128}$"
    },
    "eventType": {
      "const": "ums.profile.association-report.v1"
    },
    "producer": {
      "const": "ums"
    },
    "environment": {
      "enum": [
        "development",
        "test",
        "staging",
        "production"
      ]
    },
    "occurredAt": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "causationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "version"
      ],
      "properties": {
        "type": {
          "const": "UMS_PROFILE_BINDING"
        },
        "id": {
          "type": "string",
          "pattern": "^aps_[A-Za-z0-9_-]{18,128}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appRegistrationId"
      ],
      "properties": {
        "appRegistrationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appSubject",
        "profileState",
        "lifecycleState",
        "contentObligation"
      ],
      "properties": {
        "appSubject": {
          "type": "string",
          "pattern": "^aps_[A-Za-z0-9_-]{18,128}$"
        },
        "profileState": {
          "enum": [
            "PROFILE_REQUIRED",
            "PROFILE_READY"
          ]
        },
        "lifecycleState": {
          "enum": [
            "ACTIVE",
            "CLOSED",
            "DELETION_PENDING",
            "ERASED"
          ]
        },
        "lifecycleReason": {
          "enum": [
            "DELETION_REQUESTED",
            "DELETION_CANCELLED",
            "CLOSED",
            "ERASED",
            "REOPENED"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "profileRevision": {
          "$ref": "common.json#/$defs/version"
        },
        "retiredGeneration": {
          "type": "integer",
          "minimum": 1
        },
        "contentObligation": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycleState": {
                "const": "ERASED"
              }
            },
            "required": [
              "lifecycleState"
            ]
          },
          "then": {
            "required": [
              "retiredGeneration"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "generation"
                  ]
                },
                {
                  "required": [
                    "profileRevision"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "generation",
              "profileRevision"
            ],
            "not": {
              "required": [
                "retiredGeneration"
              ]
            }
          }
        }
      ]
    }
  }
}
