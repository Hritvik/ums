{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ums.invalid/contracts/v1/operation-event.json",
  "type": "object",
  "properties": {
    "eventId": {
      "$ref": "common.json#/$defs/uuid"
    },
    "schemaVersion": {
      "const": "1"
    },
    "producer": {
      "const": "ums"
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}(?![\\s\\S])"
    },
    "occurredAt": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}(?![\\s\\S])"
    },
    "causationId": {
      "$ref": "common.json#/$defs/uuid"
    },
    "type": {
      "enum": [
        "ums.operation.request.v1",
        "ums.operation.notice.v1",
        "ums.operation.export.v1",
        "ums.operation.content-cleanup.v1"
      ]
    },
    "scope": {
      "$ref": "common.json#/$defs/scope"
    },
    "operationReference": {
      "$ref": "common.json#/$defs/uuid"
    },
    "operationRevision": {
      "$ref": "common.json#/$defs/version"
    },
    "status": {
      "enum": [
        "ACCEPTED",
        "PENDING",
        "LOCAL_COMPLETED",
        "DELIVERY_ACKNOWLEDGED",
        "FAILED",
        "EXPIRED"
      ]
    },
    "reason": {
      "enum": [
        "APP_DELETION",
        "GLOBAL_DELETION",
        "CLOSED_EXPIRY",
        "EXPORT",
        "AVATAR_DETACH",
        "RETENTION_NOTICE"
      ]
    }
  },
  "required": [
    "eventId",
    "schemaVersion",
    "producer",
    "environment",
    "occurredAt",
    "correlationId",
    "causationId",
    "type",
    "scope",
    "operationReference",
    "operationRevision",
    "status",
    "reason"
  ],
  "additionalProperties": false
}
