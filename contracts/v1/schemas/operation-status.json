{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ums.invalid/contracts/v1/operation-status.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operationReference",
    "operationRevision",
    "status"
  ],
  "properties": {
    "operationReference": {
      "$ref": "common.json#/$defs/uuid"
    },
    "operationRevision": {
      "$ref": "common.json#/$defs/version"
    },
    "status": {
      "enum": [
        "ACCEPTED",
        "PENDING",
        "LOCAL_COMPLETED",
        "DELIVERY_ACKNOWLEDGED",
        "FAILED",
        "EXPIRED"
      ]
    }
  }
}
