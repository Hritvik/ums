{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ums.invalid/contracts/v1/profile-display.json",
  "type": "object",
  "properties": {
    "profileReference": {
      "$ref": "common.json#/$defs/uuid"
    },
    "profileRevision": {
      "$ref": "common.json#/$defs/version"
    },
    "fields": {
      "$ref": "common.json#/$defs/fields"
    },
    "displayNameSource": {
      "enum": [
        "EXPLICIT",
        "GENERATED_FALLBACK",
        "ABSENT"
      ]
    }
  },
  "required": [
    "profileReference",
    "profileRevision",
    "fields",
    "displayNameSource"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "displayNameSource": {
            "const": "EXPLICIT"
          }
        }
      },
      "then": {
        "properties": {
          "fields": {
            "required": [
              "displayName"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "fields": {
            "not": {
              "required": [
                "displayName"
              ]
            }
          }
        }
      }
    }
  ]
}
