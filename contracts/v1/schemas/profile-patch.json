{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ums.invalid/contracts/v1/profile-patch.json",
  "type": "object",
  "properties": {
    "expectedVersion": {
      "$ref": "common.json#/$defs/version"
    },
    "changes": {
      "type": "object",
      "properties": {
        "displayName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\ud800-\\udfff]+(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "avatarReference": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "displayLocale": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 2,
              "maxLength": 64,
              "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "displayTimezone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1
    }
  },
  "required": [
    "expectedVersion",
    "changes"
  ],
  "additionalProperties": false
}
