{
  "apiVersion": "ums.vik/dutch-binding-v1",
  "binding": "dutch-consumer",
  "environment": "development",
  "owner": "ums",
  "purpose": "Standalone, secret-free bindings for the UMS side of the Dutch consumer journey. Values are synthetic placeholders; live credentials are supplied by the deployment and never live in this file.",
  "services": {
    "ums": {
      "image": "eclipse-temurin:21-jre",
      "port": 8080,
      "config": "application-dutch.yaml",
      "artifact": "UMS bootJar pinned to the local commit or a release tag"
    },
    "iam-stub": {
      "image": "python:3.12-alpine",
      "port": 8081,
      "role": "ingress-producer"
    },
    "dutch-stub": {
      "image": "python:3.12-alpine",
      "port": 8082,
      "role": "association-consumer"
    }
  },
  "stores": {
    "ums": {
      "engine": "postgresql",
      "version": "17.6",
      "database": "ums",
      "migrations": 25
    },
    "dutch-stub": {
      "engine": "sqlite",
      "version": "3",
      "database": "dutch-stub.sqlite",
      "separate": true
    }
  },
  "trust": {
    "issuer": "https://iam.example.test",
    "jwkSetUri": "https://iam.example.test/.well-known/jwks.json",
    "audience": "https://ums.example.test",
    "issuerEnvironmentRef": "11111111-1111-1111-1111-111111111111",
    "callerRegistrations": "UMS_CALLER_REGISTRATIONS"
  },
  "appScope": {
    "registration": "dutch-development",
    "appReference": "22222222-2222-2222-2222-222222222222",
    "appSubject": "aps_0123456789abcdefghijkL"
  },
  "ingress": {
    "eventTypes": [
      "iam.app-subject.onboarding-ready.v1"
    ],
    "producer": "iam",
    "transport": "workload-mtls",
    "path": "/internal/v1/iam/events",
    "maxBodyBytes": 32768
  },
  "snapshotRepair": {
    "transport": "workload-bearer",
    "path": "/internal/v1/iam/snapshot",
    "page": "explicit subject; DEP-3 owns the page bound"
  },
  "egress": {
    "eventType": "ums.profile.association-report.v1",
    "consumerUri": "https://dutch.example.test/internal/ums/association-reports",
    "auth": "workload-bearer",
    "correlationHeader": "X-Correlation-ID",
    "dedupe": "eventId",
    "retry": {
      "maxAttempts": 8,
      "backoffBase": "PT30S",
      "backoffMax": "PT1H",
      "lease": "PT5M"
    }
  },
  "correlation": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "causation": "source-event-id"
  },
  "capabilities": {
    "privacyMode": false,
    "contentAuthority": false,
    "outboxRelay": false
  },
  "pin": {
    "schema": "association-report/v1/association-report.schema.json",
    "manifest": "association-report/v1/MANIFEST.json"
  }
}
